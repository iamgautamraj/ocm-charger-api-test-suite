      "name": "Structure",
      "item": [
        {
          "name": "TC-05: Required fields present in each charger record",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Response is a non-empty array\", () => {",
                  "  pm.expect(body).to.be.an(\"array\");",
                  "  pm.expect(body.length).to.be.above(0);",
                  "});",
                  "pm.test(\"Each record has required fields\", () => {",
                  "  body.forEach(p => {",
                  "    pm.expect(p.ID, \"ID\").to.be.a(\"number\");",
                  "    pm.expect(p.AddressInfo, \"AddressInfo\").to.be.an(\"object\");",
                  "    pm.expect(p.AddressInfo.Latitude, \"Latitude\").to.be.a(\"number\");",
                  "    pm.expect(p.AddressInfo.Longitude, \"Longitude\").to.be.a(\"number\");",
                  "    pm.expect(p.Connections, \"Connections\").to.be.an(\"array\");",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
