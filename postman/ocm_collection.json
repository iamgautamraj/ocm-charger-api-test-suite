        {
          "name": "TC-07: India results have coordinates inside India",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Coordinates fall inside India bounding box\", () => {",
                  "  const bad = body.filter(p => {",
                  "    const a = p.AddressInfo;",
                  "    return a.Latitude < 6 || a.Latitude > 38 || a.Longitude < 68 || a.Longitude > 98;",
                  "  }).map(p => p.ID + \" (\" + p.AddressInfo.Latitude + \", \" + p.AddressInfo.Longitude + \")\");",
                  "  pm.expect(bad, \"IDs outside India: \" + bad.join(\"; \")).to.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v3/poi/?output=json&countrycode=IN&maxresults=100&key={{api_key}}",
