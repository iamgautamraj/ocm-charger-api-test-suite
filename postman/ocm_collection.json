{
  "info": {
    "name": "Open Charge Map API Test Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"No server error (status < 500)\", () => pm.expect(pm.response.code).to.be.below(500));",
          "pm.test(\"Response time under 3000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(3000));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Search",
      "item": [
        {
          "name": "TC-01: Search chargers in India (maxresults=10)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Response is a non-empty array\", () => {",
                  "  pm.expect(body).to.be.an(\"array\");",
                  "  pm.expect(body.length).to.be.above(0);",
                  "});",
                  "pm.test(\"Respects maxresults (<= 10)\", () => pm.expect(body.length).to.be.at.most(10));",
                  "pm.test(\"All results are in India\", () => {",
                  "  body.forEach(p => {",
                  "    const c = p.AddressInfo && p.AddressInfo.Country;",
                  "    if (c) pm.expect(c.ISOCode).to.equal(\"IN\");",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v3/poi/?output=json&countrycode=IN&maxresults=10&key={{api_key}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v3",
                "poi",
                ""
              ],
              "query": [
                {
                  "key": "output",
                  "value": "json"
                },
                {
                  "key": "countrycode",
                  "value": "IN"
                },
                {
                  "key": "maxresults",
                  "value": "10"
                },
                {
                  "key": "key",
                  "value": "{{api_key}}"
                }
              ]
            }
          }
        },
